# ── Dulce Patojo SAC ── Configuración del Backend ──

# Puerto del servidor Express
PORT=5000

# Supabase — URL del proyecto (reemplazar con tu URL real)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase — Anon Key (pública, segura para el cliente, respeta RLS)
# Obtener en: Settings > API > Project API keys > anon/public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Supabase — Service Role Key (SOLO para operaciones admin, NUNCA exponer al frontend)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# (Opcional) Clave legacy — se usará como fallback si SUPABASE_ANON_KEY no está definida
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIs...

# JWT — Secreto para firmar tokens de sesión
JWT_SECRET=sb_secret_tu_secreto_aqui
